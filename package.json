{
  "name": "whatsapp-unsaved-contacts-exporter",
  "version": "1.0.0",
  "description": "An application to export unsaved WhatsApp contacts.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Jules",
  "license": "ISC",
  "devDependencies": {
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.jules.whatsappexporter",
    "productName": "WhatsApp Unsaved Contacts Exporter",
    "target": "NSIS",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
